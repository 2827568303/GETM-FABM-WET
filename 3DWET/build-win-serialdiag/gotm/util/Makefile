	cd /C/Users/23801/Desktop/GETM-FABM-WET-260928/3DWET/build-win-serialdiag && $(MAKE) $(MAKESILENT) -f gotm/util/CMakeFiles/util.dir/build.make gotm/util/CMakeFiles/util.dir/util.F90.i
.PHONY : util.F90.i

util.s: util.F90.s
.PHONY : util.s

