&turbulence
   turb_method = 2
   tke_method = 1
   len_scale_method = 1
   stab_method = 1
/

&bc
   k_ubc = 1
   k_lbc = 1
   kb_ubc = 1
   kb_lbc = 1
   psi_ubc = 1
   psi_lbc = 1
   ubc_type = 1
   lbc_type = 1
/

&turb_param
   cm0_fix = 0.5477
   Prandtl0_fix = 0.74
   cw = 100.0
   compute_kappa = .true.
   kappa = 0.4
   compute_c3 = .true.
   ri_st = 0.25
   length_lim = .true.
   galp = 0.27
   const_num = 5.0e-4
   const_nuh = 5.0e-4
   k_min = 1.0e-8
   eps_min = 1.0e-12
   kb_min = 1.0e-8
   epsb_min = 1.0e-12
/

&generic
   compute_param = .false.
   gen_m = 1.5
   gen_n = -1.0
   gen_p = 3.0
   cpsi1 = 1.44
   cpsi2 = 1.92
   cpsi3minus = 0.0
   cpsi3plus = 1.0
   cpsix = 1.44
   cpsi4 = 0.0
   sig_kpsi = 1.0
   sig_psi = 1.3
   gen_d = -1.2
   gen_alpha = -2.0
   gen_l = 0.2
/

&keps
   ce1 = 1.44
   ce2 = 1.92
   ce3minus = 0.0
   ce3plus = 1.5
   cex = 1.44
   ce4 = 0.0
   sig_k = 1.0
   sig_e = 1.3
   sig_peps = .false.
/

&kw
   cw1 = 0.555
   cw2 = 0.833
   cw3minus = 0.0
   cw3plus = 0.5
   cwx = 0.555
   cw4 = 0.15
   sig_kw = 2.0
   sig_w = 2.0
/

&my
   e1 = 1.8
   e2 = 1.33
   e3 = 1.8
   ex = 1.8
   e6 = 4.0
   sq = 0.2
   sl = 0.2
   my_length = 1
/

&scnd
   scnd_method = 0
   kb_method = 0
   epsb_method = 0
   scnd_coeff = 0
   cc1 = 0.0
   ct1 = 0.0
   ctt = 0.0
   cc2 = 0.0
   cc3 = 0.0
   cc4 = 0.0
   cc5 = 0.0
   cc6 = 0.0
   ct2 = 0.0
   ct3 = 0.0
   ct4 = 0.0
   ct5 = 0.0
/

&iw
   iw_model = 0
   alpha = 0.0
   klimiw = 1e-6
   rich_cr = 0.7
   numiw = 1.e-4
   nuhiw = 5.e-5
   numshear = 5.e-3
/
