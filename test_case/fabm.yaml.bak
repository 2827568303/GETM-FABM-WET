instances:
  abiotic_water:
    long_name: abiotic_process_in_water
    model: wet/abiotic_water
    parameters:
      diagnostics: false
    initialization:
      sNH4W: 0.05
      sNO3W: 0.5
      sPO4W: 0.1
      sPAIMW: 0.0
      sSiO2W: 3.5
      sO2W: 13.0
      sDIMW: 4.0
      sSiPaW: 0.025

  abiotic_sediment:
    long_name: abiotic_process_in_sediment
    model: wet/abiotic_sediment
    parameters:
      hypsograph: false
      diagnostics: false
      nPOM: 1
      nDOM: 1
    initialization:
      sNH4S: 0.04
      sNO3S: 0.025
      sPO4S: 0.1
      sPAIMS: 2.0
      sDIMS: 31700.0
      sSiO2S: 0.1
      sSiPaS: 14.0
    coupling:
      oxygen_pool_water: abiotic_water/sO2W
      Trans_DPOM_sediment_update1: POM/tDTrans
      Trans_DDOM_sediment_update1: DOM/tDTrans
      Trans_CPOM_sediment_update1: POM/tCTrans
      Trans_CDOM_sediment_update1: DOM/tCTrans

  bot_pel_interface:
    long_name: bot_pel_interface
    model: wet/bot_pel_interface
    parameters:
      hypsograph: false

  sediment_exchange:
    long_name: sediment_exchange
    model: wet/sediment_exchange
    parameters:
      diagnostics: false
      nPOM: 1
      nDOM: 1
      qResus: 2
      cVSetMain: 0.5
      crt_shear: 0.02
      ref_shear: 1.0
      alpha: 9000.0
      eta: 1.0
      cVSedIM: 1.0
      cVSedPOM1: 0.5
      kDDifDOM1: 0.002
      kNDifDOM1: 0.000085
      kPDifDOM1: 0.00016
      kNDifNH4: 0.000112
      kNDifNO3: 0.000086
      kPDifPO4: 0.000072
      kSiO2Dif: 0.0000864
      cThetaSed: 1.01
      cThetaDif: 1.016
      cTurbDifNut: 12.0
    coupling:
      pom_model1: POM
      dom_model1: DOM
      inorg_pool_in_sediment: abiotic_sediment/sDIMS
      PO4_in_sediment: abiotic_sediment/sPO4S
      PAIM_in_sediment: abiotic_sediment/sPAIMS
      NH4_in_sediment: abiotic_sediment/sNH4S
      NO3_in_sediment: abiotic_sediment/sNO3S
      particulate_Si_in_sediment: abiotic_sediment/sSiPaS
      dissolved_Si_in_sediment: abiotic_sediment/sSiO2S
      particulate_Si_in_water: abiotic_water/sSiPaW
      SiO2_in_water: abiotic_water/sSiO2W
      NH4_in_water: abiotic_water/sNH4W
      NO3_in_water: abiotic_water/sNO3W
      PO4_in_water: abiotic_water/sPO4W
      inorg_pool_in_water: abiotic_water/sDIMW
      PAIM_in_water: abiotic_water/sPAIMW
      bPorS: abiotic_sediment/bPorS
      bPorCorS: abiotic_sediment/bPorCorS
      cDepthS: abiotic_sediment/cDepthS
      fDepthDifS: abiotic_sediment/fDepthDifS
      bot_pel_conv: bot_pel_interface/bot_pel_conv

  burial:
    long_name: burial
    model: wet/burial
    parameters:
      nPHYT: 2
      nBENT: 0
      nMACRO: 0
      nPOM: 2
      nPOMexch: 1
      nDOM: 1
      fDOrgSoil: 0.1
      cRhoIM: 2500000.0
      cRhoOM: 1400000.0
      diagnostics: false
    coupling:
      NH4_pool_in_sediment: abiotic_sediment/sNH4S
      NO3_pool_in_sediment: abiotic_sediment/sNO3S
      PO4_pool_in_sediment: abiotic_sediment/sPO4S
      PAIM_in_sediment: abiotic_sediment/sPAIMS
      inorg_pool_in_sediment: abiotic_sediment/sDIMS
      particulate_Si_in_sediment: abiotic_sediment/sSiPaS
      humus_DW_in_deep_sediment: humus/sDS
      humus_N_in_deep_sediment: humus/sNS
      humus_P_in_deep_sediment: humus/sPS
      humus_C_in_deep_sediment: humus/sCS
      humus_DW_in_deep_sediment_PV: humus/sDS_PV
      humus_N_in_deep_sediment_PV: humus/sNS_PV
      humus_P_in_deep_sediment_PV: humus/sPS_PV
      humus_C_in_deep_sediment_PV: humus/sCS_PV
      IM_abiotic_update: sediment_exchange/tDAbioIMS
      bPorS: abiotic_sediment/bPorS
      cDepthS: abiotic_sediment/cDepthS
      bot_pel_conv: bot_pel_interface/bot_pel_conv
      POM_phytoplankton_update1: cyanobacteria/tDPOMS
      POM_phytoplankton_update2: greens/tDPOMS
      POM_sediment_update1: POM/tDPOMS
      POM_sediment_update2: humus/tDPOMS
      POM_exchange_update1: sediment_exchange/tDExchPOMS_1
      DOM_group1: DOM
      POM_group1: POM
      POM_group2: humus

  POM:
    long_name: particulate_organic_matter
    model: wet/om_pool
    parameters:
      cExtSp: 0.15
      cVSet: 0.3
      qTrans: 0
      lTransDWtarget: false
      diagnostics: false
    initialization:
      sDW: 0.1
      sNW: 0.01
      sPW: 0.001
      sCW: 0.04
      sDS: 47.4
      sNS: 0.6
      sPS: 0.1
      sCS: 18.96
      sDS_PV: 47.4
      sNS_PV: 0.6
      sPS_PV: 0.1
      sCS_PV: 18.96
    coupling:
      oxygen_pool_water: abiotic_water/sO2W
      NO3_pool_water: abiotic_water/sNO3W
      bot_pel_conv: bot_pel_interface/bot_pel_conv
      N_transformation_water: DOM/N_transformation_water
      P_transformation_water: DOM/P_transformation_water
      N_transformation_sediment: abiotic_sediment/sNH4S
      P_transformation_sediment: abiotic_sediment/sPO4S

  humus:
    long_name: humus
    model: wet/om_pool
    parameters:
      cExtSp: 0.05
      cVSet: 0.05
      qTrans: 0
      lTransDWtarget: false
      diagnostics: false
    initialization:
      sDW: 100.0
      sNW: 2.0
      sPW: 0.2
      sCW: 40.0
      sDS: 5000.0
      sNS: 100.0
      sPS: 10.0
      sCS: 2000.0
      sDS_PV: 5000.0
      sNS_PV: 100.0
      sPS_PV: 10.0
      sCS_PV: 2000.0
    coupling:
      oxygen_pool_water: abiotic_water/sO2W
      NO3_pool_water: abiotic_water/sNO3W
      bot_pel_conv: bot_pel_interface/bot_pel_conv
      N_transformation_water: DOM/N_transformation_water
      P_transformation_water: DOM/P_transformation_water
      N_transformation_sediment: abiotic_sediment/sNH4S
      P_transformation_sediment: abiotic_sediment/sPO4S

  DOM:
    long_name: dissolved_organic_matter
    model: wet/om_pool
    parameters:
      cExtSp: 0.0
      cVSet: 0.0
      qTrans: 1
      lTransDWtarget: false
      diagnostics: false
    initialization:
      sDW: 2.5
      sNW: 0.01
      sPW: 0.001
      sCW: 1.0
      sDS: 10.0
      sNS: 0.06
      sPS: 0.01
      sCS: 4.0
      sDS_PV: 10.0
      sNS_PV: 0.06
      sPS_PV: 0.01
      sCS_PV: 4.0
    coupling:
      oxygen_pool_water: abiotic_water/sO2W
      NO3_pool_water: abiotic_water/sNO3W
      bot_pel_conv: bot_pel_interface/bot_pel_conv
      N_transformation_water: abiotic_water/sNH4W
      P_transformation_water: abiotic_water/sPO4W
      N_transformation_sediment: abiotic_sediment/sNH4S
      P_transformation_sediment: abiotic_sediment/sPO4S

  cyanobacteria:
    long_name: cyanobacteria
    model: wet/phytoplankton
    parameters:
      qLightMethod: 0
      lSi: false
      diagnostics: false
    initialization:
      sDW: 0.1
      sNW: 0.003
      sPW: 0.0003
      sCW: 0.04
      sDS: 0.003
      sNS: 0.00009
      sPS: 3e-05
      sCS: 0.0012
      sDS_PV: 0.003
      sNS_PV: 0.00009
      sPS_PV: 3e-05
      sCS_PV: 0.0012
    coupling:
      PO4_pool_water: abiotic_water/sPO4W
      NH4_pool_water: abiotic_water/sNH4W
      NO3_pool_water: abiotic_water/sNO3W
      oxygen_pool_water: abiotic_water/sO2W
      POM_DW_pool_water: POM/sDW
      POM_N_pool_water: POM/sNW
      POM_P_pool_water: POM/sPW
      POM_C_pool_water: POM/sCW
      DOM_DW_pool_water: DOM/sDW
      DOM_N_pool_water: DOM/sNW
      DOM_P_pool_water: DOM/sPW
      DOM_C_pool_water: DOM/sCW
      PO4_pool_sediment: abiotic_sediment/sPO4S
      NH4_pool_sediment: abiotic_sediment/sNH4S
      POM_DW_pool_sediment: POM/sDS
      POM_N_pool_sediment: POM/sNS
      POM_P_pool_sediment: POM/sPS
      POM_C_pool_sediment: POM/sCS
      POM_DW_pool_sediment_PV: POM/sDS_PV
      POM_N_pool_sediment_PV: POM/sNS_PV
      POM_P_pool_sediment_PV: POM/sPS_PV
      POM_C_pool_sediment_PV: POM/sCS_PV
      DOM_DW_pool_sediment: DOM/sDS
      DOM_N_pool_sediment: DOM/sNS
      DOM_P_pool_sediment: DOM/sPS
      DOM_C_pool_sediment: DOM/sCS
      DOM_DW_pool_sediment_PV: DOM/sDS_PV
      DOM_N_pool_sediment_PV: DOM/sNS_PV
      DOM_P_pool_sediment_PV: DOM/sPS_PV
      DOM_C_pool_sediment_PV: DOM/sCS_PV
      SiPa_pool_water: abiotic_water/sSiPaW
      SiO2_pool_water: abiotic_water/sSiO2W
      SiPa_pool_sediment: abiotic_sediment/sSiPaS
      SiO2_pool_sediment: abiotic_sediment/sSiO2S
      bot_pel_conv: bot_pel_interface/bot_pel_conv
      base_resuspension_rate: sediment_exchange/tDResusDead
      aFunTauTmSet: sediment_exchange/aFunTauTmSet

  greens:
    long_name: greens
    model: wet/phytoplankton
    parameters:
      qLightMethod: 0
      lSi: false
      diagnostics: false
    initialization:
      sDW: 0.1
      sNW: 0.003
      sPW: 0.0003
      sCW: 0.04
      sDS: 0.003
      sNS: 0.00009
      sPS: 3e-05
      sCS: 0.0012
      sDS_PV: 0.003
      sNS_PV: 0.00009
      sPS_PV: 3e-05
      sCS_PV: 0.0012
    coupling:
      PO4_pool_water: abiotic_water/sPO4W
      NH4_pool_water: abiotic_water/sNH4W
      NO3_pool_water: abiotic_water/sNO3W
      oxygen_pool_water: abiotic_water/sO2W
      POM_DW_pool_water: POM/sDW
      POM_N_pool_water: POM/sNW
      POM_P_pool_water: POM/sPW
      POM_C_pool_water: POM/sCW
      DOM_DW_pool_water: DOM/sDW
      DOM_N_pool_water: DOM/sNW
      DOM_P_pool_water: DOM/sPW
      DOM_C_pool_water: DOM/sCW
      PO4_pool_sediment: abiotic_sediment/sPO4S
      NH4_pool_sediment: abiotic_sediment/sNH4S
      POM_DW_pool_sediment: POM/sDS
      POM_N_pool_sediment: POM/sNS
      POM_P_pool_sediment: POM/sPS
      POM_C_pool_sediment: POM/sCS
      POM_DW_pool_sediment_PV: POM/sDS_PV
      POM_N_pool_sediment_PV: POM/sNS_PV
      POM_P_pool_sediment_PV: POM/sPS_PV
      POM_C_pool_sediment_PV: POM/sCS_PV
      DOM_DW_pool_sediment: DOM/sDS
      DOM_N_pool_sediment: DOM/sNS
      DOM_P_pool_sediment: DOM/sPS
      DOM_C_pool_sediment: DOM/sCS
      DOM_DW_pool_sediment_PV: DOM/sDS_PV
      DOM_N_pool_sediment_PV: DOM/sNS_PV
      DOM_P_pool_sediment_PV: DOM/sPS_PV
      DOM_C_pool_sediment_PV: DOM/sCS_PV
      SiPa_pool_water: abiotic_water/sSiPaW
      SiO2_pool_water: abiotic_water/sSiO2W
      SiPa_pool_sediment: abiotic_sediment/sSiPaS
      SiO2_pool_sediment: abiotic_sediment/sSiO2S
      bot_pel_conv: bot_pel_interface/bot_pel_conv
      base_resuspension_rate: sediment_exchange/tDResusDead
      aFunTauTmSet: sediment_exchange/aFunTauTmSet

  zooplankton:
    long_name: zooplankton
    model: wet/zooplankton
    parameters:
      nPrey: 2
      diagnostics: false
    initialization:
      sD: 0.1
      sN: 0.007
      sP: 0.001
      sC: 0.04
    coupling:
      prey_model1: cyanobacteria
      prey_model2: greens
      POM_DW_pool_water: POM/sDW
      POM_N_pool_water: POM/sNW
      POM_P_pool_water: POM/sPW
      POM_C_pool_water: POM/sCW
      DOM_DW_pool_water: DOM/sDW
      DOM_N_pool_water: DOM/sNW
      DOM_P_pool_water: DOM/sPW
      DOM_C_pool_water: DOM/sCW
      NH4_pool_water: abiotic_water/sNH4W
      PO4_pool_water: abiotic_water/sPO4W
      oxygen_pool_water: abiotic_water/sO2W
      SiPa_pool_water: abiotic_water/sSiPaW
      SiO2_pool_water: abiotic_water/sSiO2W
