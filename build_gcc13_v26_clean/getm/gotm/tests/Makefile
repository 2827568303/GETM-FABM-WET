	cd /mnt/c/Users/dinod/Desktop/GETM-FABM-WET/build_gcc13_v26_clean/getm && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
