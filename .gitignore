# ==========================================================
# GETM-FABM-WET .gitignore
# ==========================================================

# ----- Sensitive files (NEVER commit) -----
3DWET/Git 仓库.txt
**/Git 仓库.txt
*.token
*.pat
.env
.env.local

# ----- Python caches -----
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.so

# ----- Large model output files (>100MB, GitHub limit) -----
# GETM/FABM output NetCDF files
*.2d.nc
*.3d.nc
LUOMA_EFDC_HYD.*.nc
TESTLAKE.*.nc
output.nc
output_*.nc

# ----- Backup directories (40+ GB total) -----
backup_*/
backup_*/
**/backup_*/

# ----- Model run logs -----
run.log
run_*.log
*.log

# ----- Large intermediate files -----
# meteo.nc often >100MB (ERA5 data)
meteo.nc
meteo_*.nc

# Bathymetry/rivers backup versions
bathymetry_orig.nc
bathymetry_before_fix.nc
bathymetry_1pass.nc
bathymetry_1pass_smooth.nc
bathymetry.nc.scheme_*
bathymetry.nc.backup
rivers_orig.nc
rivers.nc.backup

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Build artifacts -----
3DWET/build/
3DWET/install/
*.exe
*.o
*.mod
*.a

# ----- OS junk -----
desktop.ini
*.tmp
*.bak
